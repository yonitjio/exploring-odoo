<templates xml:space="preserve">
    <t t-name="nuido_flow_data.archive-data-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextInputDialogInput id="props.node.id" label="'Id(s)'" value="props.node.ids"
                    onChanged.bind="onIdsChanged"/>
            </div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-model-selector" t-att-for="modelSelectorId">Model</label>
                <ModelSelectorEx
                    id="modelSelectorId"
                    value="state.modelDescription"
                    onModelSelected.bind="onModelSelected"
                />
            </div>
        </xpath>
    </t>
</templates>
