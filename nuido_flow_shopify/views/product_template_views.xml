<odoo>

    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.inherit.nuido.flow.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <field name="sync_to_shopify"/>
                <field name="shopify_image" widget="image" alt="Shopify Image" options="{'size': [100, 100]}"/>
            </group>
        </field>
    </record>

</odoo>
