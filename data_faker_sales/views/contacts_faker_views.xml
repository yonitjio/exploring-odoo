<odoo>
    <data>
        <record id="res_partner_view_faker" model="ir.ui.view">
            <field name="name">res.partner.faker</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <faker>
                    <field name="is_company" values="false" />
                    <field name="type" values="contact,invoice,delivery,other" />
                    <field name="name" module="person" method="fullName" />
                    <field name="image_1920" module="image" method="url" params='{ "width": "1920", "height": "1080" }' />
                    <field name="email" module="internet" method="email" />
                    <field name="street" module="location" method="streetAddress" />
                    <field name="street2" module="location" method="secondaryAddress" />
                    <field name="city" module="location" method="city" />
                    <field name="state_id" dep="country_id" link="country_id"/>
                    <field name="country_id" />
                    <field name="zip" module="location" method="zipCode" />
                </faker>
            </field>
        </record>

        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="view_mode">kanban,list,form,activity,faker</field>
        </record>
    </data>
</odoo>
