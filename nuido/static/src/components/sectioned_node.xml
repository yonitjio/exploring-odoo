<templates xml:space="preserve">
    <t t-name="nuido.sectioned-node">
        <div t-ref="root" tabstop="0" class="node-container"
            t-attf-style="left: {{props.node.vprops.left}}px; top: {{props.node.vprops.top}}px;"
            t-on-click.stop.prevent="onClick">
            <div t-att-id="props.node.id" class="node sectioned">
                <div class="content">
                    <div class="node-title">
                        <img t-att-src="props.node.icon" class="node-icon me-2 pb-1"/>
                        <span><t t-out="props.node.title"/></span>
                    </div>
                    <div class="node-content">
                        <div class="node-sections">
                            <t t-foreach="props.node.sections" t-as="section" t-key="section.id" >
                                <t t-component="getSectionComponent(section.sectionType)" node="props.node" section="section" />
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
