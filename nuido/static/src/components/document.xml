<templates xml:space="preserve">
    <t t-name="nuido.document">
        <div t-ref="root" class="nuido-doc" t-on-mouseup="onMouseUp">
            <t t-foreach="props.document.nodes" t-as="node" t-key="node.id">
                <t t-component="getNodeComponent(node.nodeType)" node="node"/>
            </t>
            <t t-foreach="props.document.edges" t-as="edge" t-key="edge.id">
                <t t-component="edgeComponent" edge="edge" />
            </t>
            <t t-if="props.document.newEdge !== undefined">
                <t t-component="edgeComponent" cssClass="'new-edge'" edge="props.document.newEdge" />
            </t>
        </div>
    </t>
</templates>