<templates xml:space="preserve">
    <t t-name="odoo_faker.FakerRenderer">
        <div class="row m-3 d-flex justify-content-center align-items-center">
            <div class="card p-0">
                <div class="row g-0 ">
                    <div class="col-md-1 col-2 d-flex flex-column py-4 justify-content-start align-items-center bg-secondary rounded-start">
                        <h1><t t-out="state.recordCount"/></h1>
                        <div>records</div>
                    </div>
                    <div class="col-md-11 col-10">
                        <div class="card-body overflow-y-auto">
                            <h2 class="card-title">Model: <t t-out="props.model.config.resModel"/></h2>
                            <div class="card-text">
                                <div class="d-flex flex-column justify-content-end align-items-center">
                                    <div class="d-flex justify-content-end align-items-center w-100 mb-1">
                                        <div class="mx-2 flex-grow-1">
                                            <input class="form-range" min="0" t-att-max="props.archInfo.recordMaxCount" step="1" type="range" t-model="this.state.demoCount"/>
                                        </div>
                                        <span class="me-2"><t t-out="this.state.demoCount" /> records.</span>
                                    </div>
                                    <div class="d-flex justify-content-end align-items-center w-100 mb-1">
                                        <div class="mx-2  flex-grow-1">
                                            <input class="form-range" min="0" max="100" step="1" type="range" t-model="this.state.maxChildCount"/>
                                        </div>
                                        <span class="me-2"><t t-out="this.state.maxChildCount" /> max children records.</span>
                                    </div>
                                    <div class="d-flex justify-content-end align-items-center w-100 mb-1">
                                        <button t-on-click="onGenerateButtonClick" class="btn btn-primary">Generate</button>
                                    </div>
                                </div>
                                <div style="max-height: 75dvh;">
                                    <table class="table table-striped table-hover mt-3 no-cellpadding">
                                        <thead>
                                            <tr class="table-secondary">
                                                <th colspan="2">Name</th>
                                                <th>Type</th>
                                                <th>Module</th>
                                                <th>Method</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="fieldNames()" t-as="field" t-key="field_index">
                                                <t t-set="fInfo" t-value="fieldInfo(field)" />
                                                <t t-if="fInfo['hasChild']">
                                                    <tr>
                                                        <td colspan="2"><t t-out="fInfo['name']"/></td>
                                                        <td><t t-out="fInfo['type']"/></td>
                                                        <td colspan="2"></td>
                                                    </tr>
                                                    <t t-foreach="childFieldNames(field)" t-as="childField" t-key="childField_index">
                                                        <t t-set="cfInfo" t-value="childFieldInfo(field, childField)" />
                                                        <tr>
                                                            <td style="width: 5px;"></td>
                                                            <td><t t-out="cfInfo['name']"/></td>
                                                            <td><t t-out="cfInfo['type']"/></td>
                                                            <td><t t-out="cfInfo['module']"/></td>
                                                            <td><t t-out="cfInfo['method']"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="2"><t t-out="fInfo['name']"/></td>
                                                        <td><t t-out="fInfo['type']"/></td>
                                                        <td><t t-out="fInfo['module']"/></td>
                                                        <td><t t-out="fInfo['method']"/></td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
