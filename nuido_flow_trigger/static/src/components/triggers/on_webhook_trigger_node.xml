<templates xml:space="preserve">
    <t t-name="nuido_flow_trigger.on-webhook-trigger-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <label t-attf-id="label-{{props.node.id}}-hook-id" t-att-for="webhookId">Webhook Id</label>
            <div class="input-group">
                <input class="form-control border-primary" readonly="1" t-att-id="webhookId" type="text" t-att-value="trimmedText"></input>
                <button class="btn btn-primary" type="button"  t-on-click="onGenerateHookIdButtonClick">
                    <i t-attf-class="icon fa fa-refresh fa-lg align-self-center"></i>
                </button>
                <button class="btn btn-primary" type="button"  t-on-click="onCopyToClipboardButtonClick">
                    <i t-attf-class="icon fa fa-clipboard fa-lg align-self-center"></i>
                </button>
            </div>
        </xpath>
    </t>
</templates>
