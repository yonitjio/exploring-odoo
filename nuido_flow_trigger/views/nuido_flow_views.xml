<odoo>
    <data>
        <record model="ir.ui.view" id="nuido_flow_trigger_node_definition_form">
            <field name="name">nuido_flow_trigger.node.definition.form</field>
            <field name="model">nuido_flow.node.definition</field>
            <field name="inherit_id" ref="nuido_flow.nuido_flow_node_definition_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook[@id='nuido_flow_notebook']" position="inside">
                    <page name="trigger_definition" string="Trigger Definition">
                        <group>
                            <field name="trigger_definition" readonly="1" force_save="1"/>

                            <field name="trigger_model_id" readonly="1" force_save="1"/>
                            <field name="trigger_field_ids" readonly="1" force_save="1"/>

                            <field name="trigger_interval" readonly="1" force_save="1"/>
                            <field name="trigger_interval_type" readonly="1" force_save="1"/>

                            <field name="trigger_last_run" readonly="1" force_save="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>