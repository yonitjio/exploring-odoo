<odoo>
    <data>
        <!-- Action opening view on model -->
        <record model="ir.actions.client" id="action_cheat_owl">
            <field name="name">Owl</field>
            <field name="tag">cheat_owl</field>
        </record>

        <record model="ir.actions.client" id="action_cheat_owl_qweb">
            <field name="name">QWeb</field>
            <field name="tag">cheat_owl_qweb</field>
        </record>

        <record model="ir.actions.client" id="action_cheat_owl_comp_interaction">
            <field name="name">Component Interaction</field>
            <field name="tag">cheat_owl_comp_interaction</field>
        </record>

        <menuitem name="Owl" id="cheat_owl_menu_top" parent="cheat_module.cheat_menu_root"
            sequence="100" />
        <menuitem name="Owl" id="cheat_owl_menu" parent="cheat_owl_menu_top"
            action="action_cheat_owl" sequence="10" />
        <menuitem name="QWeb" id="cheat_owl_qweb_menu" parent="cheat_owl_menu_top"
            action="action_cheat_owl_qweb" sequence="20" />
        <menuitem name="Components Interaction" id="cheat_owl_comp_interaction"
            parent="cheat_owl_menu_top"
            action="action_cheat_owl_comp_interaction" sequence="50" />
    </data>
</odoo>
