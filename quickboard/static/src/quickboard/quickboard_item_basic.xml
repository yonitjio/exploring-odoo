<templates xml:space="preserve">
    <t t-name="quickboard.QuickboardItemBasic">
        <div t-ref="this.gsItemRef" class="grid-stack-item h-100 overflow-hidden d-flex flex-column">
            <div t-ref="this.containerRef" class="d-flex flex-column flex-fill p-1">
                <div class="d-flex p-1 flex-grow-1"
                    t-att-style="'color:' + this.state.textColor + '; background-color: ' + this.state.backgroundColor">
                    <div class="quickboard-item-basic-icon ps-2">
                        <span><i t-attf-class="oi {{ this.state.icon_filled ? 'oi-filled' : '' }}" t-att-data-icon="this.state.icon"/></span>
                    </div>
                    <div class="d-flex flex-column text-end flex-grow-1 align-self-end h-100">
                        <span class="quickboard-item-chart-icon me-1 flex-fill">
                            <i class="oi" data-icon="settings" t-on-click="(ev) => this.showItemConfig(ev)"/>
                        </span>
                        <div class="quickboard-item-basic-value flex-wrap w-100 pe-1">
                            <span><t t-out="this.state.value"/></span>
                        </div>
                    </div>
                </div>
                <div class="quickboard-item-basic-title text-center"><t t-out="this.state.title"/></div>
            </div>
        </div>
    </t>
</templates>
