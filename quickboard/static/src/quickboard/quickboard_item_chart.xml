<templates xml:space="preserve">
    <t t-name="quickboard.QuickboardItemChart">
        <div t-ref="this.gsItemRef" class="grid-stack-item h-100 p-2 pb-5 overflow-hidden">
            <div class="quickboard-item-chart-title d-flex justify-content-between">
                <div>
                    <span class="quickboard-item-chart-icon mx-1">
                        <i t-attf-class="oi {{ this.state.icon_filled ? 'oi-fw' : '' }}" t-att-data-icon="this.state.icon"/>
                    </span>
                    <span><t t-out="this.state.title"/></span>
                </div>
                <span class="quickboard-item-cog me-1">
                    <i class="oi" data-icon="settings" t-on-click="(ev) => this.showItemConfig(ev)"/>
                </span>
            </div>
            <div class="pt-4 px-3 w-100 h-100">
                <div class="h-100 w-100">
                    <canvas t-ref="this.chartCanvasRef" />
                </div>
            </div>
        </div>
    </t>
</templates>