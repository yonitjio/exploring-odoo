<templates xml:space="preserve">

    <t t-name="quickboard.QbColorPickerField">
        <QbColorList canToggle="this.props.canToggle"
            colors="this.currentColorPalette()"
            forceExpanded="this.isExpanded"
            onColorSelected.bind="this.switchColor"
            selectedColor="this.props.record.data[this.props.name] || 0"/>
    </t>

</templates>
