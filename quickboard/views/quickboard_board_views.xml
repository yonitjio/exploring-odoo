<odoo>
    <data>
        <record id="quickboard_board_view_list" model="ir.ui.view">
            <field name="name">quickboard.board.list</field>
            <field name="model">quickboard.board</field>
            <field name="arch" type="xml">
                <list string="Quickboards" editable="bottom" default_order="sequence, id">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="quickboard_board_view_form" model="ir.ui.view">
            <field name="name">quickboard.board.form</field>
            <field name="model">quickboard.board</field>
            <field name="arch" type="xml">
                <form string="Quickboard">
                    <sheet>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="quickboard_board_action_window" model="ir.actions.act_window">
            <field name="name">Quickboards</field>
            <field name="res_model">quickboard.board</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Boards" id="quickboard_board_menu_action_window" parent="quickboard.menu_root"
            groups="group_quickboard_user" action="quickboard_board_action_window" sequence="5"/>
    </data>
</odoo>