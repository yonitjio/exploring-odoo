<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nuido.flow.ai.website.chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="nuido_flow.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='nuido_flow']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <xpath expr="//block[@id='nuido_flow']" position="inside">
                <setting id="nuido_flow_ai_mini_knowledge_summarizer" string="Summarizer for Mini Knowledge">
                    <field name="mini_knowledge_summarizer_node_definition_id" options="{'no_open': True, 'no_create': True}" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
