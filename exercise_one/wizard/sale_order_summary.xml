<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_summary_view" model="ir.ui.view">
            <field name="name">sale.order.summary.view</field>
            <field name="model">sale.order.summary</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form edit="false" create="false">
                    <field name="order_ids">
                        <list>
                            <field name="name" string="Order"/>
                            <field name="partner_id" string="Customer"/>
                            <field name="amount_total" string="Amount" sum="Total"/>
                            <field name="amount_paid" string="Paid"  sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="order_line" string="# of Product" widget="one2many_summary"
                                options="{ 'method': 'count', 'field': 'product_id', 'format': 'integer' }" class="text-end"/>
                            <field name="order_line" string="Qty" widget="one2many_summary"
                                options="{ 'method': 'sum', 'field': 'product_uom_qty', 'format': 'float' }" class="text-end"/>
                        </list>
                    </field>
                    <footer>
                        <button string="Close" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
