<templates xml:space="preserve">
    <t t-name="nuido_flow_messaging.notify-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextDialogInput id="props.node.id" label="'Template'" value="props.node.template" onChanged.bind="onTemplateChanged"/>
            </div>
            <div class="mb-2 form-check form-switch">
                <input t-att-id="stickyInputId" type="checkbox" t-att-checked="props.node.sticky" t-att-value="props.node.sticky"
                    t-on-click="onStickyChanged"
                    class="form-check-input"/>
                <label t-attf-id="label-{{props.node.id}}-sticky" t-att-for="stickyInputId" t-on-click="onStickyChanged"
                    class="form-check-label ms-2 d-inline">Sticky</label>
            </div>
        </xpath>
    </t>
</templates>
