<templates xml:space="preserve">
    <t t-name="nuido_flow_jinja.jinja-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextDialogInput id="props.node.id" label="'Template'" value="props.node.template" onChanged.bind="onTemplateChanged"/>
            </div>
            <div class="mb-2 form-check form-switch">
                <input t-att-id="asDictionaryInputId" type="checkbox" t-att-checked="props.node.as_dictionary"
                    t-att-value="props.node.as_dictionary"
                    t-on-click="onAsDictionaryChanged"
                    class="form-check-input"/>
                <label t-attf-id="label-{{props.node.id}}-as-dictionary" t-att-for="asDictionaryInputId"
                    t-on-click="onAsDictionaryChanged"
                    class="form-check-label ms-2 d-inline">Dictionary output</label>
            </div>
        </xpath>
    </t>
</templates>
