<templates xml:space="preserve">
    <t t-name="nuido_flow_sales.graphql-client-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextInputDialogInput id="props.node.id + 'url'" label="'URL'" value="props.node.url" onChanged.bind="onUrlChanged"/>
                <TextDialogInput id="props.node.id + 'query'" label="'Query'" value="props.node.query" onChanged.bind="onQueryChanged"/>
            </div>
        </xpath>
    </t>
</templates>
