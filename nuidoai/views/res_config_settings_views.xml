<odoo>
    <record id="res_config_settings_cheat_module" model="ir.ui.view">
        <field name="name">res_config_settings_cheat_module</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block title="AI Agent" name="contacts_setting_container">
                    <setting id="cheat_setting" string="AI Agent" help="AI Agent to be used for AI chat">
                        <field name="node_definition" options="{'no_open': True, 'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>