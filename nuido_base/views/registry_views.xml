<odoo>
    <data>
        <record model="ir.ui.view" id="nuido_base_registry_list">
            <field name="name">nuido_base.registry.list</field>
            <field name="model">nuido_base.registry</field>
            <field name="arch" type="xml">
                <list string="Nuido Registry" editable="top" create="1" delete="1">
                    <field name="category" />
                    <field name="key" />
                    <field name="value" />
                </list>
            </field>
        </record>

        <record id="action_nuido_base_registry" model="ir.actions.act_window">
            <field name="name">Nuido Registry</field>
            <field name="path">nuido-registry</field>
            <field name="res_model">nuido_base.registry</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>