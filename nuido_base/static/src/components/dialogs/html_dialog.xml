<templates xml:space="preserve">

<t t-name="nuido_base.html-dialog">
    <Dialog title="props.title">
        <div class="h-100" t-att-class="{'o_show_codeview': state.showCodeView}" style="min-height:400px;">
            <t t-if="state.showCodeView">
                <textarea t-ref="codeView" class="o_codeview" t-att-value="this.value" t-on-change="onChange"/>
            </t>
            <Wysiwyg
                config="this.getConfig()"
                onLoad.bind="onEditorLoad"
                contentClass="`note-editable ${this.state.showCodeView ? 'd-none' : ''}`"
                onBlur.bind="onBlur"
                t-key="wysiwygKey"/>
        </div>
        <div t-if="state.showCodeView" style="position:absolute; top: 1px; right: 1px" t-ref="codeViewButton" id="codeview-btn-group" class="btn-group" t-on-click="toggleCodeView">
            <button class="o_codeview_btn btn btn-primary">
                <i class="fa fa-code" />
            </button>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="onClickApply">
                Apply
            </button>
            <button class="btn btn-secondary" t-on-click="props.close">
                Cancel
            </button>
        </t>
    </Dialog>
</t>

</templates>