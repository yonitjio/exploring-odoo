<templates xml:space="preserve">
    <t t-name="nuido_base.dropdown-input-section" t-inherit="nuido.node-section" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-section-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.section.id}}"><t t-out="props.section.label"/></label>
                <select t-attf-id="text-{{props.section.id}}" class="form-select" t-model="state.value">
                    <t t-foreach="props.section.options" t-as="option" t-key="option_index">
                        <option t-att-value="option.value"><t t-out="option.name"/></option>
                    </t>
                </select>
            </div>
        </xpath>
    </t>
</templates>
