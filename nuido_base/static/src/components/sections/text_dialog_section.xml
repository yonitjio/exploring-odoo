<templates xml:space="preserve">
    <t t-name="nuido_base.text-dialog-input-section" t-inherit="nuido.node-section" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-section-content')]" position="inside">
            <div class="mb-2" >
                <label t-attf-id="label-{{props.section.id}}"><t t-out="props.section.label"/></label>
                <div class="input-group">
                    <input class="form-control border-primary" readonly="1" t-attf-id="text-{{props.section.id}}" type="text" t-att-value="trimmedText"></input>
                    <button class="btn btn-primary" type="button"  t-on-click="showTextDialog">
                        <i t-attf-class="icon fa fa-ellipsis-h fa-lg align-self-center"></i>
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
