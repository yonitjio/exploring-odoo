<templates xml:space="preserve">
    <t t-name="nuido_base.text-input-section" t-inherit="nuido.node-section" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-section-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.section.id}}"><t t-out="props.section.label"/></label>
                <input t-attf-id="text-{{props.section.id}}" type="text" t-model="state.value"></input>
            </div>
        </xpath>
    </t>
</templates>
