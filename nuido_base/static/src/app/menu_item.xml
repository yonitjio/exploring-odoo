<templates xml:space="preserve">
    <t t-name="nuido_base.menu-item">
        <div t-ref="root" class="menu-item-container w-100 my-2">
            <div class="menu-item text-center text-md-start">
                <t t-if="props.icon">
                    <img class="menu-icon me-2" t-att-src="props.icon"></img>
                </t>
                <span class="d-none d-md-inline"><t t-out="props.title"/></span>
            </div>
        </div>
    </t>
</templates>
