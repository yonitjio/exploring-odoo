<templates xml:space="preserve">
    <t t-name="nuido_flow.flow-studio" t-inherit="nuido_base.studio" t-inherit-mode="primary">
        <xpath expr="//div[@id='nuido-data-button-group']" position="before">
            <div class="btn-group mx-1">
                <button id="nuido-data-button-run" t-on-click.stop.prevent="onRunButtonClick" class="btn btn-primary text-danger" data-tooltip="Run">
                    <i class="fa fa-play"/>
                </button>
                <button id="nuido-data-button-process" t-on-click.stop.prevent="onProcessButtonClick" class="btn btn-primary text-danger" data-tooltip="Process">
                    <i class="fa fa-check"/>
                </button>
                <button id="nuido-data-button-reset-states" t-on-click.stop.prevent="onResetProcessingStateButtonClick" class="btn btn-primary text-danger" data-tooltip="Clear Node States">
                    <i class="fa fa-backward"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
