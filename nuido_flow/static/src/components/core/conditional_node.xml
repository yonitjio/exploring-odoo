<templates xml:space="preserve">
    <t t-name="nuido_flow.conditional-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextDialogInput id="props.node.id" label="'Condition'" value="props.node.condition" onChanged.bind="onConditionChanged"/>
            </div>
        </xpath>
    </t>
</templates>
