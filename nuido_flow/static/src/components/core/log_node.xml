<templates xml:space="preserve">
    <t t-name="nuido_flow.log-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-tag" t-attf-for="text-{{props.node.id}}-tag">Tag</label>
                <input t-attf-id="text-{{props.node.id}}-tag" type="text" t-model="props.node.tag"></input>
            </div>
        </xpath>
    </t>
</templates>
