<templates xml:space="preserve">
    <t t-name="nuido_base.map-tree-dialog">
        <Dialog title="Mapper">
            <div>
                <MapTree nodes="state.map" node="state.map[0]"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onClickApply">
                Apply
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">
                Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>