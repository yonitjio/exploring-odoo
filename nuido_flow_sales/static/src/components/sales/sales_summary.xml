<templates xml:space="preserve">
    <t t-name="nuido_flow_sales.sales-summary-odoo" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-type" t-att-for="summaryTypeInputId">Type</label>
                <select class="form-control" t-att-id="summaryTypeInputId" t-model="props.node.summary_type">
                    <option t-att-selected="props.node.summary_type === 'day'" value="day">Day</option>
                    <option t-att-selected="props.node.summary_type === 'week'" value="week">Week</option>
                    <option t-att-selected="props.node.summary_type === 'month'" value="month">Month</option>
                    <option t-att-selected="props.node.summary_type === 'year'" value="year">Year</option>
                </select>
            </div>
        </xpath>
    </t>
</templates>
