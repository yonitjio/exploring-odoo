<templates xml:space="preserve">
    <t t-name="nuido_flow_ai_chat.on-ai-chat-message-trigger-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="my-2">
                <ChatDialogButton disabled="chatDialogButtonDisabled" getNodeDefId.bind="getNodeDefId" beforeShow.bind="onBeforeShowChatDialog"/>
            </div>
        </xpath>
    </t>
</templates>
