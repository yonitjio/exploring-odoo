<templates xml:space="preserve">
    <t t-name="nuido_flow_ai_chat.chat-dialog">
        <Dialog size="'lg'" title="title" bodyClass="'d-flex'" contentClass="'h-100'">
            <AiChat
                userName="props.userName"
                userAvatarUrl="props.userAvatarUrl"

                assistantName="props.assistantName"
                assistantAvatarUrl="props.assistantAvatarUrl"

                greetingMessage="props.greetingMessage"
                greetUser="props.greetUser"

                storeName="props.storeName"

                channel="props.channel"
                bus="props.bus"

                isProcessing="isProcessing"

                onBeforeSendMessage.bind="onBeforeSendMessage"
                onSendMessage.bind="onSendMessage"

                allowUpload="true"
            />
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="props.close">Close</button>
                <button class="btn" t-on-click="reset">Reset</button>
            </t>
        </Dialog>
    </t>
</templates>
