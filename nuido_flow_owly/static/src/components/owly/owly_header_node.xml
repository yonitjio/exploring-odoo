<templates xml:space="preserve">
    <t t-name="nuido_flow_owly.owly-header-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <TextInputDialogInput id="props.node.id" label="'Secret'" value="props.node.secret"
                    onChanged.bind="onSecretChanged"
                    hideValue="true"/>
            </div>
        </xpath>
    </t>
</templates>
